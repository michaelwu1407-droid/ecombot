# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Messaging (bridge provider: Zernio)
MESSAGING_PROVIDER=zernio            # zernio | meta | mock
MESSAGING_PROVIDER_API_KEY=          # Zernio key, format sk_<64 hex>
MESSAGING_WEBHOOK_SECRET=            # Zernio webhook secret (HMAC-SHA256, X-Zernio-Signature)

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                    # pinned, never 'auto'

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Observability
SENTRY_DSN=

# Encryption for connections.credentials (32-byte key, base64 or 64-char hex)
ENCRYPTION_KEY=

# Cron authentication (Vercel cron)
CRON_SECRET=

# Research delegation (Hermes Agent, operator agent only — see BUILD_SPEC §3.7)
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MODEL=
